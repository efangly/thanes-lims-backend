APP_ENV=local
APP_PORT=8080
AUTO_MIGRATE=false

DATABASE_URL=postgres://user:pass@host:5432/thanes_lims?sslmode=require

JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Refresh Cookie (see docs/adr/0004-refresh-token-in-httponly-cookie.md).
# COOKIE_SECURE must be true in production (https). Set to false only for
# local http:// development.
COOKIE_SECURE=true
# CORS_ALLOW_ORIGINS is only needed when the frontend runs on a different
# origin than the API - e.g. a local dev server on a different port
# (http://localhost:5173). Comma-separated exact origins, no wildcard.
# Leave empty in same-origin production deployments.
CORS_ALLOW_ORIGINS=

MINIO_ENDPOINT=host:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=thanes-lims
MINIO_USE_SSL=true

# Read-through Cache (Refresh Token fast-path lookup, Location Full Path) -
# see docs/adr/0005-redis-cache-for-refresh-tokens-and-location-full-path.md.
REDIS_URL=redis://user:pass@host:6379

LOG_LEVEL=info

AUTO_REORDER_ENABLED=true
AUTO_REORDER_INTERVAL=1h

# Oracle (Select AI chatbot POC) - separate ADB, not the Postgres system of record.
# Day-to-day app connections use the dedicated CHATBOT_APP user, not ADMIN
# (see scripts/oracle/000_create_app_user.sql).
ORACLE_DSN=CHATBOT_APP/"password"@limsdb_high
ORACLE_TNS_ADMIN=/path/to/wallet

# OCI Generative AI (Select AI Phase 3) - API signing key credential used by
# DBMS_CLOUD.CREATE_CREDENTIAL inside the POC Oracle ADB. Never commit real
# values - this file only holds placeholders.
OCI_USER_OCID=ocid1.user.oc1..changeme
OCI_TENANCY_OCID=ocid1.tenancy.oc1..changeme
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=us-chicago-1
OCI_PRIVATE_KEY_PATH=/path/to/oci_api_key.pem
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..changeme

# Select AI provider (Phase 3) - switched to OpenAI: the ADB's region
# (ap-samutprakan-1) has no OCI Generative AI service and no other
# subscribed region does either. See docs/chatbot-poc-plan.md.
OPENAI_API_KEY=sk-changeme

# ADMIN DSN - only needed once, to grant the network ACL for
# api.openai.com via DBMS_NETWORK_ACL_ADMIN.APPEND_HOST_ACE (CHATBOT_APP
# isn't privileged enough). Not needed day-to-day.
ORACLE_ADMIN_DSN=ADMIN/password@limsdb_high

APP_ENV=local
APP_PORT=8080
AUTO_MIGRATE=false

DATABASE_URL=postgres://user:pass@host:5432/thanes_lims?sslmode=require

JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Refresh Cookie (see docs/adr/0004-refresh-token-in-httponly-cookie.md).
# COOKIE_SECURE must be true in production (https). Set to false only for
# local http:// development.
COOKIE_SECURE=true
# CORS_ALLOW_ORIGINS is only needed when the frontend runs on a different
# origin than the API - e.g. a local dev server on a different port
# (http://localhost:5173). Comma-separated exact origins, no wildcard.
# Leave empty in same-origin production deployments.
# Required when APP_ENV != local (the app refuses to start with a wildcard
# CORS policy in a non-local environment).
CORS_ALLOW_ORIGINS=

# TRUSTED_PROXIES lists the IPs / CIDR ranges of the load balancers or reverse
# proxies in front of this service, comma-separated. Only then does c.IP()
# trust the forwarded client IP (recorded in the Token Family), so it can't be
# spoofed by an arbitrary caller. PROXY_HEADER is the header c.IP() reads from
# when the request comes through a trusted proxy (e.g. X-Forwarded-For).
# Leave both empty when the service is exposed directly.
TRUSTED_PROXIES=
PROXY_HEADER=

MINIO_ENDPOINT=host:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=thanes-lims
MINIO_USE_SSL=true

# Read-through Cache (Refresh Token fast-path lookup, Location Full Path) -
# see docs/adr/0005-redis-cache-for-refresh-tokens-and-location-full-path.md.
REDIS_URL=redis://user:pass@host:6379

LOG_LEVEL=info

AUTO_REORDER_ENABLED=true
AUTO_REORDER_INTERVAL=1h

# Oracle (chatbot POC) - separate ADB, not the Postgres system of record.
# Day-to-day app connections use the dedicated CHATBOT_APP user, not ADMIN
# (see scripts/oracle/000_create_app_user.sql).
# ORACLE_ENABLED must be true to activate the ADB integration; when true,
# ORACLE_DSN is required and the app fails at boot if it is missing.
ORACLE_ENABLED=false
ORACLE_DSN=CHATBOT_APP/"password"@limsdb_high
ORACLE_TNS_ADMIN=/path/to/wallet

# Chatbot POC (see docs/chatbot-poc-plan.md, 2026-09-02 pivot). NL->SQL and
# narration run against the Claude API from Go (not Oracle Select AI). The
# generated SQL runs against the ADB as the read-only CHATBOT_RO user.
# ANTHROPIC_API_KEY may be left empty if the SDK resolves credentials another
# way (`ant auth login`).
ANTHROPIC_API_KEY=sk-ant-changeme
CHATBOT_MODEL=claude-haiku-4-5-20251001
# Read-only DB credential for chatbot queries. Empty falls back to ORACLE_DSN.
ORACLE_CHATBOT_DSN=CHATBOT_RO/"password"@limsdb_high

# ADMIN DSN - only needed once, to run scripts/oracle/003_create_readonly_user.sql
# (CHATBOT_APP cannot CREATE USER). Not needed day-to-day.
ORACLE_ADMIN_DSN=ADMIN/password@limsdb_high

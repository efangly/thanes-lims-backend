APP_ENV=local
APP_PORT=8080
AUTO_MIGRATE=false

DATABASE_URL=postgres://user:pass@host:5432/thanes_lims?sslmode=require

JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Refresh Cookie (see docs/adr/0004-refresh-token-in-httponly-cookie.md).
# COOKIE_SECURE must be true in production (https). Set to false only for
# local http:// development.
COOKIE_SECURE=true
# CORS_ALLOW_ORIGINS is only needed when the frontend runs on a different
# origin than the API - e.g. a local dev server on a different port
# (http://localhost:5173). Comma-separated exact origins, no wildcard.
# Leave empty in same-origin production deployments.
# Required when APP_ENV != local (the app refuses to start with a wildcard
# CORS policy in a non-local environment).
CORS_ALLOW_ORIGINS=

# TRUSTED_PROXIES lists the IPs / CIDR ranges of the load balancers or reverse
# proxies in front of this service, comma-separated. Only then does c.IP()
# trust the forwarded client IP (recorded in the Token Family), so it can't be
# spoofed by an arbitrary caller. PROXY_HEADER is the header c.IP() reads from
# when the request comes through a trusted proxy (e.g. X-Forwarded-For).
# Leave both empty when the service is exposed directly.
TRUSTED_PROXIES=
PROXY_HEADER=

# Object storage (documents) - S3-compatible. For OCI Object Storage:
#   STORAGE_ENDPOINT = <namespace>.compat.objectstorage.<region>.<realm-domain>
#     (this tenancy is the OC43 realm -> domain is oci.thaiaiscloud.com,
#      NOT oraclecloud.com)
#   STORAGE_REGION   = OCI region id, e.g. ap-samutprakan-1 (required for SigV4)
#   STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY = an IAM user's Customer Secret Key
STORAGE_ENDPOINT=NAMESPACE.compat.objectstorage.ap-samutprakan-1.oci.thaiaiscloud.com
STORAGE_REGION=ap-samutprakan-1
STORAGE_ACCESS_KEY=changeme
STORAGE_SECRET_KEY=changeme
STORAGE_BUCKET=lims-bucket
STORAGE_USE_SSL=true

# Read-through Cache (Refresh Token fast-path lookup, Location Full Path) -
# see docs/adr/0005-redis-cache-for-refresh-tokens-and-location-full-path.md.
REDIS_URL=redis://user:pass@host:6379

LOG_LEVEL=info

AUTO_REORDER_ENABLED=true
AUTO_REORDER_INTERVAL=1h

# Partner Device (SMtrack third-party device data via gRPC, see
# docs/partner-api-guide.md, docs/adr/0012-partner-api-grpc-transport.md and
# CONTEXT.md#environment). PARTNER_API_ENABLED must be true to activate
# polling; when true, PARTNER_GRPC_ADDR/PARTNER_API_KEY are required and the
# app fails at boot if either is missing. PARTNER_GRPC_ADDR is a bare
# host:port gRPC dial target - no http(s):// scheme.
PARTNER_API_ENABLED=false
PARTNER_GRPC_ADDR=siamatic.thddns.net:50051
PARTNER_API_KEY=pk_live_changeme
PARTNER_API_POLL_INTERVAL=30s
PARTNER_API_CACHE_TTL=45s
PARTNER_API_STALE_MAX=5m

# MCP server (cmd/mcp-server) - separate process/binary from cmd/api, exposes
# read-only Sample/TestResult/Inventory/PurchaseOrder tools over MCP
# Streamable HTTP for the external NestJS+LangGraph.js chatbot service (see
# docs/adr/0013-mcp-server-transport.md and docs/mcp-server-tools.md).
# Reads Postgres directly through the existing repositories. MCP_SERVICE_API_KEY
# is a static shared secret the NestJS service sends as X-Service-Api-Key on
# every request, checked in addition to the forwarded end-user JWT
# (Authorization: Bearer <jwt>). Generate a long random value per
# environment; there is no default.
MCP_SERVER_PORT=8090
MCP_SERVICE_API_KEY=changeme
